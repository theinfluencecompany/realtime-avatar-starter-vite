# Server-only. Never prefix with VITE_ (that would ship it to the browser).
# Get one at https://realtimeavatar.ai/platform/settings#api-keys
REALTIME_AVATAR_API_KEY=

# Optional, server: which avatar ids the server may call (comma separated).
# Unset = only the public example avatar "seed-rin-ashfall".
# REALTIME_AVATAR_IDS=ava_...

# Optional, page: the avatar the page calls (must also be in REALTIME_AVATAR_IDS).
# VITE_REALTIME_AVATAR_ID=ava_...
# VITE_REALTIME_AVATAR_NAME=Rin

# Optional, page: use the Supabase Edge Function instead of the Node route.
# Lovable and Bolt's Supabase integration set these for you.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, page: point at a server route hosted anywhere else.
# VITE_REALTIME_AVATAR_PROXY_URL=https://api.example.com/realtime-avatar
